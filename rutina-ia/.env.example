# ---------------------------------------------------------------------------
# Motor de generación
# ---------------------------------------------------------------------------
# La app puede hablar con Claude por dos vías, y funciona sin ninguna de ellas
# (cae al planificador determinista).
#
#   suscripcion  Usa el CLI de Claude Code de esta máquina, que ya tiene tu
#                sesión iniciada. Consume de tu plan Pro/Max, no de saldo de
#                API. Requiere `npm i -g @anthropic-ai/claude-code` y
#                `claude login`. No necesita nada más aquí.
#
#   api          Llama a la API de Anthropic con clave propia, facturada por
#                uso. Define ANTHROPIC_API_KEY abajo.
#
# Por defecto («auto») se prefiere la suscripción, luego la API y por último
# el planificador determinista. Fija uno concreto con RUTINA_IA_ENGINE.

# ANTHROPIC_API_KEY=sk-ant-...
# RUTINA_IA_ENGINE=auto              # auto | suscripcion | api | determinista

# --- Ajustes del motor de suscripción --------------------------------------
# RUTINA_IA_CLAUDE_CODE_BIN=claude
# RUTINA_IA_CLAUDE_CODE_TIMEOUT=420  # segundos por turno; generar tarda

# --- Ajustes del motor de API ----------------------------------------------
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=high              # low | medium | high | xhigh | max
# ANTHROPIC_MAX_TOKENS=32000

# --- Comunes ---------------------------------------------------------------
# RUTINA_IA_MAX_REPAIRS=2            # reintentos con el informe del validador
# RUTINA_IA_MAX_CANDIDATES=260       # ejercicios enviados al modelo
# RUTINA_IA_CATALOG=data/catalog.json
# RUTINA_IA_MEDIA=data/media
